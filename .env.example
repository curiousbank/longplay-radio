# The default path is deterministic, local, and requires no account or API key.
LONGPLAY_RENDERER=fake
LONGPLAY_STORAGE=local
LONGPLAY_LOCAL_ROOT=./var/storage
LONGPLAY_OBJECT_PREFIX=longplay/genblaze/v1

# Generic local Coqui TTS. Used only when LONGPLAY_RENDERER=coqui.
# Choose an operator-installed, single-speaker model. Job payloads cannot
# choose models, speakers, clone samples, executable paths, or CLI flags.
LONGPLAY_COQUI_BIN=/absolute/path/to/tts
LONGPLAY_COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC
LONGPLAY_COQUI_TIMEOUT_SECONDS=120

# Direct Backblaze B2 S3 API. Used only when LONGPLAY_STORAGE=b2_s3.
# Enable file version history on the private bucket before a real run.
B2_BUCKET=
B2_REGION=us-west-004
B2_KEY_ID=
B2_APP_KEY=
